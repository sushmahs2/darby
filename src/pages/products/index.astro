---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../data/products';
---
<BaseLayout title="Products" description="Explore Darby Trading product categories including agricultural equipment, CNC and laser, 3D printers, tools and materials."><section class="page-hero"><div class="eyebrow">PRODUCT CATALOGUE</div><h1>Explore our <em>product areas.</em></h1><p>Browse categories below. Product models, specifications, pricing and availability are confirmed on enquiry.</p></section><section class="section catalogue"><div class="product-grid">{categories.map((item,i)=><article class="product-card" id={item.slug}><span class="card-index">{String(i+1).padStart(2,'0')}</span><div><h2>{item.name}</h2><p>{item.summary}</p><a class="text-link" href={`/contact/?category=${encodeURIComponent(item.name)}`}>Enquire about this category ↗</a></div></article>)}</div></section></BaseLayout>
