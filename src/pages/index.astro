---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/products';
---
<BaseLayout title="Global Sourcing & Trading" description="Explore equipment, tools, materials and trading enquiries with Darby Trading."><section class="hero"><div class="eyebrow">DARBY TRADING <span> / </span> PRODUCT SOURCING</div><h1>Ideas move forward.<br/><em>We help source what’s next.</em></h1><p>Explore a broad range of equipment, technologies and materials through one clear point of contact.</p><div class="actions"><a class="button primary" href="/products/">Explore products <span aria-hidden="true">↗</span></a><a class="button secondary" href="/contact/">Discuss your requirement</a></div><div class="hero-bottom"><span>INDUSTRY & EQUIPMENT</span><span>TECHNOLOGY & MATERIALS</span><span>TRADING ENQUIRIES</span></div></section><section class="section intro"><div class="eyebrow dark">01 / WHAT WE OFFER</div><div><h2>Built around your <em>next requirement.</em></h2><p>From agricultural equipment to manufacturing technology and raw materials, browse our product areas and connect with our team to discuss availability and specifications.</p></div></section><section class="section catalogue"><div class="section-heading"><div><div class="eyebrow dark">02 / OUR PRODUCT AREAS</div><h2>Explore the range.</h2></div><a class="text-link" href="/products/">All categories ↗</a></div><div class="product-grid">{categories.slice(0,6).map((category,i)=><a class="product-card" href={`/products/#${category.slug}`}><span class="card-index">0{i+1}</span><div><h3>{category.name}</h3><p>{category.summary}</p></div><span class="card-arrow" aria-hidden="true">↗</span></a>)}</div></section><section class="contact-band"><div class="eyebrow">LET'S CONNECT</div><h2>Have a specific<br/><em>requirement in mind?</em></h2><a class="button light" href="/contact/">Start an enquiry ↗</a></section></BaseLayout>
