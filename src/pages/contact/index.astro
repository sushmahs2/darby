---
import BaseLayout from '../../layouts/BaseLayout.astro';
const category = Astro.url.searchParams.get('category') ?? '';
---
<BaseLayout title="Contact" description="Contact Darby Trading to discuss product sourcing, equipment and materials enquiries."><section class="page-hero"><div class="eyebrow">GET IN TOUCH</div><h1>Let’s discuss <em>your requirements.</em></h1><p>Tell us what you’re looking for, including model, quantity and delivery location. We’ll help you identify the next step.</p></section><section class="section contact-content"><div><div class="eyebrow dark">PRODUCT ENQUIRIES</div><h2>Start a conversation.</h2><p>For now, use the enquiry email link to open your preferred email application. No information is stored on this website.</p></div><form id="enquiry-form" class="enquiry-form"><label>Your name<input name="name" required autocomplete="name" maxlength="120"/></label><label>Email address<input type="email" name="email" required autocomplete="email"/></label><label>Product category<input name="category" value={category} maxlength="150"/></label><label>Requirements<textarea name="message" required rows="5" maxlength="5000" placeholder="Product, quantity, specifications, destination..."></textarea></label><button class="button primary" type="submit">Compose enquiry email ↗</button><p class="form-note">This opens your email application; please review and send the message there.</p></form></section><script>document.querySelector<HTMLFormElement>('#enquiry-form')?.addEventListener('submit', e => {e.preventDefault();const form=e.currentTarget as HTMLFormElement;if(!form.reportValidity())return;const data=new FormData(form);const name=String(data.get('name')??'');const email=String(data.get('email')??'');const category=String(data.get('category')??'');const message=String(data.get('message')??'');const subject=encodeURIComponent('Darby Trading enquiry'+(category?' — '+category:''));const body=encodeURIComponent(`Name: ${name}\nEmail: ${email}\nCategory: ${category}\n\nRequirements:\n${message}`);window.location.href=`mailto:?subject=${subject}&body=${body}`;});</script></BaseLayout>
